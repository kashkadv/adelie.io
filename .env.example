# Root .env for all apps and packages. Never commit .env.
# On a dev machine run `pnpm env:pull` to generate .env from the dev server secrets.

# Database / Redis (dev server over Tailscale, or localhost when running infra/dev locally)
DATABASE_URL=postgresql://adelie:change-me@adelie:5432/adelie
REDIS_URL=redis://:change-me@adelie:6379

# Auth (Better Auth)
BETTER_AUTH_SECRET=change-me-32-bytes-random
BETTER_AUTH_URL=http://localhost:4000

# Encryption of social platform tokens at rest (AES-256-GCM; 32 random bytes, base64:
# `openssl rand -base64 32`). Rotation: put the old key into TOKEN_ENCRYPTION_PREVIOUS_KEYS
# as "1:<old key>", set the new key here and bump TOKEN_ENCRYPTION_KEY_VERSION.
TOKEN_ENCRYPTION_KEY=change-me
# TOKEN_ENCRYPTION_KEY_VERSION=1
# TOKEN_ENCRYPTION_PREVIOUS_KEYS=

# Pinterest developer app (App ID is public, secret is not)
PINTEREST_APP_ID=1635003
PINTEREST_APP_SECRET=change-me

# Apps
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
