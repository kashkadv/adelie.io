# TLS terminates at Cloudflare; Caddy serves plain HTTP inside the tunnel.
{
	auto_https off
	admin off
}

:80 {
	# Cloudflare passes the visitor's scheme in X-Forwarded-Proto.
	@http header X-Forwarded-Proto http
	redir @http https://{host}{uri} permanent

	@www host www.adelie.space
	redir @www https://adelie.space{uri} permanent

	root * /srv
	try_files {path} {path}.html {path}/index.html
	file_server

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		-Server
	}

	handle_errors {
		respond "{err.status_code}" {err.status_code}
	}
}
