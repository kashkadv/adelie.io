// Adelie database schema.
// Auth tables (User, Session, Account, Verification) follow the Better Auth core schema.
// Every workspace-owned resource must reference workspaceId (see docs/product-requirements.md §4.3).

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth (Better Auth) ----------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions           Session[]
  accounts           Account[]
  memberships        WorkspaceMember[]
  socialConnections  SocialConnection[]
  profile            UserProfile?
  connectInvitations ConnectInvitation[]
  preferences        UserPreference[]
  productChanges     ShopProductChange[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------- Personal profile (ADR-0010) ----------

/// Personal settings of a user, one per person across all workspaces. Visible to the user and to
/// members of workspaces they share. `user.name` is kept in sync as "firstName lastName".
model UserProfile {
  userId    String  @id
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String?
  lastName  String?
  jobTitle  String?

  /// Avatar, resized on the client to 256×256 (WebP/JPEG/PNG, ≤ 150 KB). Moves to object storage later.
  avatar          Bytes?
  avatarMime      String?
  avatarUpdatedAt DateTime?

  /// Contact email for colleagues; may differ from the sign-in email (user.email).
  contactEmail String?
  phone        String?
  telegram     String?
  whatsapp     String?
  viber        String?
  linkedin     String?

  /// Working hours: IANA timezone, ISO weekdays (1 = Monday … 7 = Sunday), "HH:MM" interval.
  timezone  String?
  workDays  Int[]   @default([1, 2, 3, 4, 5])
  workStart String?
  workEnd   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_profile")
}

/// Per-user interface settings that follow the person across devices and projects (e.g. the
/// Content table columns per platform). `key` names the setting; `value` is validated by the API.
model UserPreference {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@id([userId, key])
  @@map("user_preference")
}

// ---------- Workspaces ----------

enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  ANALYST
  VIEWER
}

model Workspace {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  WorkspaceMember[]
  projects Project[]

  @@map("workspace")
}

model WorkspaceMember {
  id          String        @id @default(uuid(7)) @db.Uuid
  workspaceId String        @db.Uuid
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  projectAssignments ProjectMember[]

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_member")
}

// ---------- Projects (ADR-0007) ----------
// Children of Project carry a denormalized `workspaceId` (tenant filter, PRD §4.3) without a
// separate FK: deletion cascades through Project, and services always set it from the project.

model Project {
  id           String    @id @default(uuid(7)) @db.Uuid
  workspaceId  String    @db.Uuid
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  timezone     String    @default("UTC")
  currency     String    @default("USD")
  reportLocale String    @default("en")
  /// Order of the project's connections (account ids), as the member arranged them: the Connections
  /// list and the channel switch of Products follow it, the first catalogue channel is the default.
  /// Accounts not listed follow in the order they were connected.
  accountOrder String[]  @default([])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  members     ProjectMember[]
  connections SocialConnection[]
  accounts    SocialAccount[]
  invitations ConnectInvitation[]

  @@index([workspaceId])
  @@map("project")
}

/// Assignment of a workspace member to a project. OWNER/ADMIN see all projects without it.
model ProjectMember {
  id          String          @id @default(uuid(7)) @db.Uuid
  workspaceId String          @db.Uuid
  projectId   String          @db.Uuid
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberId    String          @db.Uuid
  member      WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())

  @@unique([projectId, memberId])
  @@index([memberId])
  @@map("project_member")
}

// ---------- Social platforms ----------

enum SocialPlatform {
  PINTEREST
  INSTAGRAM
  TIKTOK
  /// Point of sale (ADR-0018): the "account" is the shop.
  ETSY
  /// A website with a Google Merchant feed (ADR-0021): the "account" is the feed's address.
  WEBSITE
}

enum ConnectionStatus {
  ACTIVE
  REAUTHORIZATION_REQUIRED
  REVOKED
}

/// OAuth grant for one platform user. Tokens are encrypted at rest (AES-256-GCM,
/// TOKEN_ENCRYPTION_KEY, `keyVersion` for rotation) and never sent to the frontend.
model SocialConnection {
  id                    String           @id @default(uuid(7)) @db.Uuid
  workspaceId           String           @db.Uuid
  projectId             String           @db.Uuid
  project               Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  platform              SocialPlatform
  externalUserId        String
  scopes                String[]
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  keyVersion            Int              @default(1)
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  status                ConnectionStatus @default(ACTIVE)
  connectedByUserId     String?
  connectedBy           User?            @relation(fields: [connectedByUserId], references: [id], onDelete: SetNull)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  accounts SocialAccount[]
  syncRuns SyncRun[]

  @@unique([workspaceId, platform, externalUserId])
  @@index([projectId])
  @@map("social_connection")
}

/// Invitation link to connect a social account to a project without signing in to Adelie
/// (ADR-0012): for a client of the agency, or the user's own account in another browser.
/// Single-use, expires, revocable. The token itself is never stored in plain text.
model ConnectInvitation {
  id              String         @id @default(uuid(7)) @db.Uuid
  workspaceId     String         @db.Uuid
  projectId       String         @db.Uuid
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  platform        SocialPlatform
  /// SHA-256 of the token — the lookup key.
  tokenHash       String         @unique
  /// The token encrypted (AES-GCM) so members can copy the link again.
  tokenEncrypted  String
  createdByUserId String?
  createdBy       User?          @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  expiresAt       DateTime
  usedAt          DateTime?
  revokedAt       DateTime?
  /// The connection created through this invitation.
  connectionId    String?        @db.Uuid
  /// Access the connection will ask for (ADR-0019): "read" or "write".
  access          String         @default("read")
  /// Set when the invitation updates access of a connected account (ADR-0020).
  accountId       String?        @db.Uuid
  account         SocialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())

  @@index([projectId])
  @@map("connect_invitation")
}

/// A profile on a platform (e.g. Gushka's Pinterest business account).
model SocialAccount {
  id                String           @id @default(uuid(7)) @db.Uuid
  workspaceId       String           @db.Uuid
  projectId         String           @db.Uuid
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connectionId      String           @db.Uuid
  connection        SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  platform          SocialPlatform
  externalId        String
  username          String?
  displayName       String?
  /// The member gave the account its own name: syncing does not overwrite `displayName`.
  displayNameCustom Boolean          @default(false)
  avatarUrl         String?
  accountType       String?

  /// Latest profile counters (history lives in AccountMetricValue). null = unavailable.
  followersCount Int?
  followingCount Int?
  postsCount     Int?

  /// Earliest date the platform returned history for (Pinterest: 90 days before connecting).
  historyAvailableFrom DateTime? @db.Date
  /// Date Adelie started collecting daily data itself (PRD §6.4, shown in the UI).
  collectingSince      DateTime? @db.Date
  lastSyncedAt         DateTime?
  lastSuccessfulSyncAt DateTime?
  /// A member asked for a sync now; the worker picks it up if it is newer than lastSyncedAt.
  syncRequestedAt      DateTime?
  /// Hidden by a member: left out of Overview/Content and listed on Accounts only on demand.
  /// Syncing is unaffected.
  hiddenAt             DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  boards       SocialBoard[]
  posts        SocialPost[]
  metricValues AccountMetricValue[]
  postMetrics  PostMetricValue[]
  postDaily    PostMetricDaily[]
  postLatest   PostMetricsLatest[]
  syncRuns     SyncRun[]
  products     ShopProduct[]
  orders       ShopOrder[]
  ledger       ShopLedgerEntry[]
  audiences    AccountAudience[]
  invitations  ConnectInvitation[]
  trackedSite  TrackedSite?

  @@unique([workspaceId, platform, externalId])
  @@index([projectId])
  @@index([connectionId])
  @@map("social_account")
}

/// Pinterest board (ADR-0008). Board analytics = our aggregation of pin metrics.
model SocialBoard {
  id          String        @id @default(uuid(7)) @db.Uuid
  workspaceId String        @db.Uuid
  projectId   String        @db.Uuid
  accountId   String        @db.Uuid
  account     SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  externalId  String
  name        String
  description String?
  privacy     String?
  pinCount    Int?
  coverUrl    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  posts SocialPost[]

  @@unique([accountId, externalId])
  @@map("social_board")
}

enum PostContentType {
  IMAGE
  VIDEO
  CAROUSEL
  PRODUCT
  OTHER
}

/// A unit of content (a pin).
model SocialPost {
  id           String          @id @default(uuid(7)) @db.Uuid
  workspaceId  String          @db.Uuid
  projectId    String          @db.Uuid
  accountId    String          @db.Uuid
  account      SocialAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  boardId      String?         @db.Uuid
  board        SocialBoard?    @relation(fields: [boardId], references: [id], onDelete: SetNull)
  externalId   String
  url          String?
  contentType  PostContentType @default(OTHER)
  /// The account's own post (true) or someone else's saved to its boards (Pinterest repin: no metrics).
  isOwn        Boolean         @default(true)
  title        String?
  description  String?
  thumbnailUrl String?
  publishedAt  DateTime?
  /// Where the post leads (Pinterest pin link).
  link         String?
  /// Days covered by PostMetricDaily (ADR-0013): inside this range a missing day means zero activity.
  dailyFrom    DateTime?       @db.Date
  dailyTo      DateTime?       @db.Date
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  metricValues PostMetricValue[]
  dailyValues  PostMetricDaily[]
  latest       PostMetricsLatest?
  links        SocialPostLink[]

  @@unique([accountId, externalId])
  @@index([accountId, publishedAt])
  @@index([boardId])
  @@map("social_post")
}

// ---------- Metrics (ADR-0008) ----------

enum MetricScope {
  ACCOUNT
  POST
}

enum MetricUnit {
  COUNT
  RATE
  SECONDS
}

/// How values combine over a period. RATIO = recompute numerator/denominator, never average.
enum MetricAggregation {
  SUM
  AVG
  LAST
  RATIO
  NONE
}

enum MetricValueKind {
  DAILY
  LIFETIME
  PERIOD
  SNAPSHOT
}

enum DataStatus {
  READY
  PROCESSING
  ESTIMATE
  UNAVAILABLE
}

/// Metric catalogue (shared, not per workspace; seeded by migrations).
/// UI description: i18n key `metrics.<key>`.
model MetricDefinition {
  id             Int               @id @default(autoincrement())
  platform       SocialPlatform
  scope          MetricScope
  /// Our cross-platform key, e.g. `impressions`, `saves`, `engagement_rate`.
  key            String
  /// Original platform name, e.g. Pinterest `IMPRESSION`.
  providerKey    String
  unit           MetricUnit
  aggregation    MetricAggregation
  valueKind      MetricValueKind
  /// For RATIO metrics: keys of the components (same platform and scope).
  numeratorKey   String?
  denominatorKey String?

  accountValues AccountMetricValue[]
  postValues    PostMetricValue[]
  postDaily     PostMetricDaily[]

  @@unique([platform, scope, key])
  @@unique([platform, scope, providerKey])
  @@map("metric_definition")
}

/// Account-level time series: one row per (account, metric, day, dimensions).
/// Kept forever (cheap, and the platform cannot return it again after 90 days).
model AccountMetricValue {
  id             BigInt           @id @default(autoincrement())
  workspaceId    String           @db.Uuid
  accountId      String           @db.Uuid
  account        SocialAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  metricId       Int
  metric         MetricDefinition @relation(fields: [metricId], references: [id])
  /// Platform day (UTC) or snapshot date.
  date           DateTime         @db.Date
  /// Canonical dimension string, e.g. `app_type=MOBILE`; '' = totals.
  dimensionKey   String           @default("")
  /// null = no data (never 0).
  value          Float?
  dataStatus     DataStatus
  providerStatus String?
  source         String
  apiVersion     String
  fetchedAt      DateTime

  @@unique([accountId, metricId, date, dimensionKey])
  @@index([workspaceId])
  @@map("account_metric_value")
}

/// Post-level snapshots: a row is written only when the value changes; it is valid from `date`
/// until the next row. Old snapshots may later be thinned (weekly → monthly).
model PostMetricValue {
  id             BigInt           @id @default(autoincrement())
  workspaceId    String           @db.Uuid
  accountId      String           @db.Uuid
  account        SocialAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  postId         String           @db.Uuid
  post           SocialPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  metricId       Int
  metric         MetricDefinition @relation(fields: [metricId], references: [id])
  date           DateTime         @db.Date
  dimensionKey   String           @default("")
  value          Float?
  dataStatus     DataStatus
  providerStatus String?
  source         String
  apiVersion     String
  fetchedAt      DateTime

  @@unique([postId, metricId, date, dimensionKey])
  @@index([accountId])
  @@index([workspaceId])
  @@map("post_metric_value")
}

/// Daily per-post values (ADR-0013) for metrics over a period. Sparse: a READY day with zero activity
/// has no row — within SocialPost.dailyFrom..dailyTo a missing day means 0, outside it means no data.
/// metricId points to the post metric (e.g. Pinterest POST `impressions`); the value is that day's count.
model PostMetricDaily {
  postId      String           @db.Uuid
  post        SocialPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  workspaceId String           @db.Uuid
  accountId   String           @db.Uuid
  account     SocialAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  metricId    Int
  metric      MetricDefinition @relation(fields: [metricId], references: [id])
  date        DateTime         @db.Date
  value       Float?
  dataStatus  DataStatus
  fetchedAt   DateTime

  @@id([postId, metricId, date])
  @@index([accountId, date])
  @@index([workspaceId])
  @@map("post_metric_daily")
}

/// Derived wide row per post for sorting and top lists; recomputed by the worker after a sync.
/// Source of truth is PostMetricValue. null = no data.
model PostMetricsLatest {
  postId         String        @id @db.Uuid
  post           SocialPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  workspaceId    String        @db.Uuid
  projectId      String        @db.Uuid
  accountId      String        @db.Uuid
  account        SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  boardId        String?       @db.Uuid
  impressions    Int?
  saves          Int?
  pinClicks      Int?
  outboundClicks Int?
  engagements    Int?
  videoViews     Int?
  engagementRate Float?
  /// Instagram (views ≠ Pinterest impressions — kept apart, docs/integrations/instagram.md).
  views          Int?
  reach          Int?
  likes          Int?
  comments       Int?
  shares         Int?
  /// Worst status among the underlying values.
  dataStatus     DataStatus
  asOfDate       DateTime      @db.Date
  updatedAt      DateTime      @updatedAt

  @@index([accountId])
  @@index([projectId])
  @@index([boardId])
  @@map("post_metrics_latest")
}

// ---------- Synchronization ----------

enum SyncKind {
  INITIAL
  DAILY
  MANUAL
  RETRY
}

enum SyncStatus {
  PENDING
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
  REAUTHORIZATION_REQUIRED
}

model SyncRun {
  id            String           @id @default(uuid(7)) @db.Uuid
  workspaceId   String           @db.Uuid
  projectId     String           @db.Uuid
  connectionId  String           @db.Uuid
  connection    SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  accountId     String?          @db.Uuid
  account       SocialAccount?   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind          SyncKind
  status        SyncStatus       @default(PENDING)
  correlationId String
  startedAt     DateTime?
  finishedAt    DateTime?
  requestCount  Int              @default(0)
  /// Counters: posts/boards/values upserted, skipped, etc.
  stats         Json?
  errorCode     String?
  errorMessage  String?
  createdAt     DateTime         @default(now())

  payloads SyncPayload[]

  @@index([connectionId, createdAt])
  @@index([accountId, createdAt])
  @@index([workspaceId])
  @@map("sync_run")
}

/// Raw API response bodies, kept 90 days (ADR-0008) to re-derive metrics after a mapping bug.
/// Response body only — request headers (tokens) are never stored.
model SyncPayload {
  id          BigInt   @id @default(autoincrement())
  workspaceId String   @db.Uuid
  syncRunId   String   @db.Uuid
  syncRun     SyncRun  @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  endpoint    String
  params      Json?
  httpStatus  Int
  body        Json
  fetchedAt   DateTime

  @@index([syncRunId])
  @@index([fetchedAt])
  @@map("sync_payload")
}

// ---------- Sales (ADR-0018): shop = SocialAccount of a point-of-sale platform ----------

/// A product the shop sells (Etsy listing). Money: integer minor units of `currency` (cents).
model ShopProduct {
  id               String        @id @default(uuid(7)) @db.Uuid
  workspaceId      String        @db.Uuid
  projectId        String        @db.Uuid
  accountId        String        @db.Uuid
  account          SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  externalId       String
  title            String
  url              String?
  imageUrl         String?
  /// Platform state: active, inactive, sold_out, draft, expired.
  state            String
  price            Int?
  currency         String?
  quantity         Int?
  /// Lifetime counters as the platform reports them (null = not reported).
  views            Int?
  favorers         Int?
  tags             String[]      @default([])
  /// Distinct non-empty SKUs of the product's variations (Etsy inventory); links it to the same
  /// product on other channels (ADR-0021).
  skus             String[]      @default([])
  /// The articles of `skus` (\"00011512/1\" → \"00011512\"): what products of different channels are
  /// matched by (a website feed's `g:id`).
  articles         String[]      @default([])
  /// What a site's feed says about the product beyond the basics: description, brand, category…
  details          Json?
  /// The product's category as the channel gives it (a site feed's `product_type`).
  category         String?
  /// Live variations (Etsy inventory products); null = not read yet.
  variationCount   Int?
  /// Options the SKU goes by (e.g. ["Color"]); empty = one SKU for the whole listing.
  skuBy            String[]      @default([])
  /// How many SKUs the product should have: one per combination of the `skuBy` options.
  skuGroups        Int?
  /// Names of the options the variations are made of ("Primary color", "Size").
  variationOptions String[]      @default([])
  /// Listings that are the same product (same variations; only their order or photos differ) share
  /// a group; null = alone. Twins are not duplicates of each other's SKU (ADR-0021).
  twinGroupId      String?       @db.Uuid
  listedAt         DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  orderItems   ShopOrderItem[]
  changes      ShopProductChange[]
  issueIgnores ShopProductIssueIgnore[]
  seoChecks    ProductSeoCheck[]

  @@unique([accountId, externalId])
  @@index([projectId])
  @@index([projectId, twinGroupId])
  @@map("shop_product")
}

/// An order (Etsy receipt). No buyer personal data is stored — only the country, for geography.
model ShopOrder {
  id          String        @id @default(uuid(7)) @db.Uuid
  workspaceId String        @db.Uuid
  projectId   String        @db.Uuid
  accountId   String        @db.Uuid
  account     SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  externalId  String
  orderedAt   DateTime
  status      String?
  isPaid      Boolean?
  isShipped   Boolean?
  /// Money in minor units of `currency`: what the buyer paid (total) and its parts.
  currency    String
  total       Int?
  subtotal    Int?
  shipping    Int?
  tax         Int?
  discount    Int?
  country     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  items ShopOrderItem[]

  @@unique([accountId, externalId])
  @@index([accountId, orderedAt])
  @@index([projectId, orderedAt])
  @@map("shop_order")
}

/// One line of an order (Etsy transaction).
model ShopOrderItem {
  id                String       @id @default(uuid(7)) @db.Uuid
  orderId           String       @db.Uuid
  order             ShopOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String?      @db.Uuid
  product           ShopProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  externalId        String
  productExternalId String?
  title             String?
  quantity          Int
  /// Unit price, minor units of the order currency.
  price             Int?

  @@unique([orderId, externalId])
  @@index([productId])
  @@map("shop_order_item")
}

/// Money movements of a shop's payment account (Etsy ledger): sales, taxes, refunds, fees, ads,
/// payouts. `amount` in minor units of `currency`, signed as the platform reports it.
model ShopLedgerEntry {
  id            String        @id @default(uuid(7)) @db.Uuid
  workspaceId   String        @db.Uuid
  projectId     String        @db.Uuid
  accountId     String        @db.Uuid
  account       SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  externalId    String
  occurredAt    DateTime
  /// The platform's own type, e.g. `transaction`, `prolist`, `PAYMENT_GROSS`.
  type          String
  /// Our grouping: sales, tax, refund, transaction_fee, processing_fee, listing_fee, ads, vat, payout, other.
  category      String
  referenceType String?
  referenceId   String?
  amount        Int
  currency      String

  @@unique([accountId, externalId])
  @@index([projectId, occurredAt])
  @@map("shop_ledger_entry")
}

/// Audit of changes made to a product from Adelie (ADR-0019): who changed what, from what to what.
model ShopProductChange {
  id          String      @id @default(uuid(7)) @db.Uuid
  workspaceId String      @db.Uuid
  projectId   String      @db.Uuid
  productId   String      @db.Uuid
  product     ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// { field: { from, to } } — only the fields that changed.
  changes     Json
  /// applied | failed
  status      String
  error       String?
  createdAt   DateTime    @default(now())

  @@index([productId, createdAt])
  @@map("shop_product_change")
}

/// Links of a post (ADR-0018): its own link (Pinterest) and URLs in its text (pin description,
/// Instagram caption). `key` is what the link points to — `etsy:<listing>` or `url:<host><path>` —
/// and matches shop products (by platform id, or by product page URL for sites).
model SocialPostLink {
  id          String     @id @default(uuid(7)) @db.Uuid
  postId      String     @db.Uuid
  post        SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  workspaceId String     @db.Uuid
  projectId   String     @db.Uuid
  url         String
  key         String
  /// link | text
  source      String

  @@unique([postId, key])
  @@index([projectId, key])
  @@map("social_post_link")
}

/// Who an account's audience is, as the platform reports it on a day (demographics, interests).
/// Account level only — platforms give no demographics per post. `groups`: { ages: [{key, name,
/// ratio}], genders: […], countries: […], interests: […] … }.
model AccountAudience {
  id               String        @id @default(uuid(7)) @db.Uuid
  workspaceId      String        @db.Uuid
  accountId        String        @db.Uuid
  account          SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// engaged | total
  type             String
  date             DateTime      @db.Date
  size             Int?
  /// `size` is a ceiling ("up to 10k"), not an estimate.
  sizeIsUpperBound Boolean       @default(false)
  groups           Json
  fetchedAt        DateTime

  @@unique([accountId, type, date])
  @@map("account_audience")
}

/// A problem the user marked as intended for one product ("this is on purpose"): it is not shown
/// as a problem any more, but can be brought back.
model ShopProductIssueIgnore {
  id          String      @id @default(uuid(7)) @db.Uuid
  workspaceId String      @db.Uuid
  projectId   String      @db.Uuid
  productId   String      @db.Uuid
  product     ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// An issue code of apps/api sales/product-issues.ts.
  code        String
  userId      String?
  createdAt   DateTime    @default(now())

  @@unique([productId, code])
  @@map("shop_product_issue_ignore")
}

/// One SEO check of a site product's page (ADR-0021): made by a member's click, never on a schedule.
/// The history shows what changed between checks.
model ProductSeoCheck {
  id          String      @id @default(uuid(7)) @db.Uuid
  workspaceId String      @db.Uuid
  projectId   String      @db.Uuid
  productId   String      @db.Uuid
  product     ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId      String?
  createdAt   DateTime    @default(now())
  /// The address that was read, and where it ended up after redirects within the site.
  url         String
  finalUrl    String?
  status      Int?
  loadMs      Int?
  bytes       Int?
  /// The page could not be read at all (unreachable, not allowed…).
  error       String?
  /// SeoMetrics of packages/platforms.
  metrics     Json?

  @@index([productId, createdAt])
  @@map("product_seo_check")
}

/// A website that sends events through Flipper, Adelie's tracker (ADR-0022). One per connected site.
model TrackedSite {
  id           String        @id @default(uuid(7)) @db.Uuid
  workspaceId  String        @db.Uuid
  projectId    String        @db.Uuid
  accountId    String        @unique @db.Uuid
  account      SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// The id in the install snippet: it names the site, it is not a secret ("fl_" + random).
  publicId     String        @unique
  /// Hosts the site's events may come from (the feed's host to begin with). A hint against
  /// misuse, not authentication: browsers can be made to send anything.
  allowedHosts String[]      @default([])
  /// "anonymous" (wait for consent) or "granted" (the site's own decision: no banner). Baked
  /// into the script the site loads, so changing it needs no change on the site.
  consentMode  String        @default("anonymous")
  /// SHA-256 of the site's server key (the shop's backend reports purchases with it); the key
  /// itself is shown once. serverKeyHint is its last four characters, to tell keys apart.
  serverKeyHash String?      @unique
  serverKeyHint String?
  /// What the site measures (ADR-0026): its kind ("store", "landing"), its goals and funnel steps.
  /// Validated by the API; funnel null = the kind's funnel. Evaluated when reading.
  kind         String        @default("store")
  goals        Json          @default("[]")
  funnel       Json?
  createdAt    DateTime      @default(now())

  events WebsiteEvent[]

  @@index([projectId])
  @@map("tracked_site")
}

/// One event of a visitor on a tracked site. Without consent (`consent` false) nothing identifies
/// the visitor: no visitor or session id, only what happened and where it came from.
model WebsiteEvent {
  id           String      @id @default(uuid(7)) @db.Uuid
  siteId       String      @db.Uuid
  site         TrackedSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  /// The browser's id for the event: a repeated send is not a second event.
  eventId      String
  name         String
  occurredAt   DateTime
  receivedAt   DateTime    @default(now())
  consent      Boolean
  visitorId    String?
  sessionId    String?
  /// The site's own id of the visitor, as a salted hash (never the id itself); full mode only.
  userKey      String?
  /// Without consent: a hash of what the request carried (address, browser, the site) with a salt
  /// that changes every day — it counts one visitor once a day and cannot follow anyone across days.
  dailyId      String?
  /// The page address without its query (only the allowed parameters are kept elsewhere).
  url          String
  title        String?
  referrerHost String?
  /// Where the visit came from: separate parts, as read from the landing address and referrer.
  source       String?
  medium       String?
  campaign     String?
  content      String?
  term         String?
  clickIdType  String?
  channel      String?
  device       String?
  isBot        Boolean     @default(false)
  properties   Json?

  @@unique([siteId, eventId])
  @@index([siteId, occurredAt])
  @@index([siteId, name, occurredAt])
  @@index([siteId, userKey])
  @@map("website_event")
}

/// A tracked link of a project (Link Builder, ADR-0027): where it leads and the campaign labels it
/// carries. Two forms: the full address with the labels, and go.adelie.space/<code> that counts the
/// click and redirects. Labels never change once created (they are in published addresses).
model TrackedLink {
  id            String      @id @default(uuid(7)) @db.Uuid
  workspaceId   String      @db.Uuid
  projectId     String      @db.Uuid
  /// The short form's code: 7 characters a-z0-9, unique across all projects.
  code          String      @unique
  name          String?
  /// Where the link leads, without the labels (they are added from the fields below).
  destination   String
  source        String
  medium        String
  campaign      String?
  /// utm_content: the place of the link ("bio", "pin-123"), the code when none was given.
  content       String
  /// When the short form was last written to Workers KV; null = not (yet) there.
  publishedAt   DateTime?
  createdAt     DateTime    @default(now())
  archivedAt    DateTime?

  clicks LinkClick[]

  @@index([projectId])
  @@map("tracked_link")
}

/// One click on a short link, as the Worker saw it. Nothing that identifies the person: no address.
model LinkClick {
  id           String      @id @default(uuid(7)) @db.Uuid
  linkId       String      @db.Uuid
  link         TrackedLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  occurredAt   DateTime
  referrerHost String?
  country      String?
  device       String?
  /// Link previews (messengers, social networks) and crawlers.
  isBot        Boolean     @default(false)

  @@index([linkId, occurredAt])
  @@map("link_click")
}
